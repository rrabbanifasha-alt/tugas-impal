// Prisma schema for Sayurikat (Modul 1 + Feedback)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String
  address   String   // Fokus ke area Tangerang / Gading Serpong
  latitude  Float?   // Titik Koordinat (opsional)
  longitude Float?   // Titik Koordinat (opsional)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@map("users")
}

model Product {
  id          String   @id @default(cuid())
  name        String   // Contoh: Paket Hijau Tumis
  description String
  price       Float    // Harga dalam IDR (misal: 18000)
  category    String   // Kategori: "Paket" atau "Satuan"
  stock       Int      // Stok tersedia
  imageUrl    String   // URL Gambar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@map("products")
}

enum OrderStatus {
  PENDING
  DIPROSES
  DIKIRIM
  SELESAI
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  orderDate     DateTime    @default(now())
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  deliveryFee   Float       @default(10000)
  paymentMethod String      @default("COD") // 'COD' | 'QRIS' | 'TRANSFER_BCA' | 'TRANSFER_MANDIRI'
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Feedback {
  id                String   @id @default(cuid())
  freshnessRating   String   // 'Layu' | 'Biasa saja' | 'Sangat Segar'
  packagingRating   String   // 'Robek' | 'Aman tapi berantakan' | 'Sangat Rapi'
  deliveryRating    String   // 'Terlambat' | 'Tepat Waktu'
  experienceRating  String   // 'Ribet' | 'Gampang banget'
  criticismNotes    String   // Teks kritik pedas / saran terbuka
  photoUrl          String?  // Bukti foto (base64 / URL)
  customerName      String?  // Nama pembeli (opsional)
  customerPhone     String?  // No. WA pembeli (opsional)
  orderNumber       String?  // Nomor / Tanggal pesanan (opsional)
  createdAt         DateTime @default(now())

  @@map("feedbacks")
}
